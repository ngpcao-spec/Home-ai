LLM_PROVIDER=mock
LLM_MODEL=gpt-5.6
OPENAI_API_KEY=
LLM_TIMEOUT_MS=10000
RESPONSE_MODE=hybrid
PORT=3000
VITE_APP_NAME=Home-ai
# Identifiant public navigateur. À restreindre par HTTP referrers et à l'API Maps JavaScript.
# Placeholder only; never commit a real Amazon Location browser API key.
AMAZON_LOCATION_API_KEY=

# Identifiants publics du client navigateur Supabase. Toujours les fournir ensemble.
# SUPABASE_ANON_KEY doit être la clé anon/publishable, jamais service_role ou sb_secret_*.
SUPABASE_URL=
SUPABASE_ANON_KEY=
